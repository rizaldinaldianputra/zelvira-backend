#################################
# SERVER & APP
#################################
SERVER_PORT=8081
APP_ADMIN_INITIAL_PASSWORD=password

#################################
# DATABASE (Postgres)
#################################
POSTGRES_DB=zelvira
POSTGRES_USER=rizaldi
POSTGRES_PASSWORD=your_password_here
DB_URL=jdbc:postgresql://postgres:5432/zelvira
DB_USERNAME=rizaldi
DB_PASSWORD=your_password_here

#################################
# REDIS
#################################
REDIS_HOST=redis
REDIS_PORT=6379

#################################
# MAIL (SMTP)
#################################
MAIL_HOST=mail.zelvira.my.id
MAIL_PORT=587
MAIL_USERNAME=noreply@zelvira.my.id
MAIL_PASSWORD=your_mail_password
MAIL_FROM=noreply@zelvira.my.id
MAIL_SENDER_NAME="Zelixa Official"

#################################
# GOOGLE OAUTH
#################################
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.zelvira.my.id/api/v1/auth/google/callback
NEXT_PUBLIC_WEB_URL=https://zelvira.my.id

#################################
# MINIO STORAGE
#################################
MINIO_ENDPOINT=http://minio:9000
MINIO_URL=http://minio:9000
MINIO_PUBLIC_URL=https://minio.zelvira.my.id
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=zelixa-bucket

#################################
# RAJAONGKIR
#################################
RAJAONGKIR_API_KEY=your_rajaongkir_api_key
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1/calculate/domestic-cost

#################################
# MIDTRANS PAYMENT
#################################
MIDTRANS_MERCHANT_ID=your_merchant_id
MIDTRANS_SERVER_KEY=your_server_key
MIDTRANS_CLIENT_KEY=your_client_key
MIDTRANS_IS_PRODUCTION=true

#################################
# FIREBASE
#################################
FIREBASE_CONFIG_PATH=firebase-service-account.json

#################################
# WHATSAPP OTP (ZENZIVA)
#################################
ZENZIVA_URL=https://console.zenziva.net/waofficial/api/sendWAOfficial/
ZENZIVA_USERKEY=your_zenziva_userkey
ZENZIVA_PASSKEY=your_zenziva_passkey
ZENZIVA_BRAND=Zelvira

#################################
# DIGIFLAZZ (PPOB)
#################################
DIGIFLAZZ_USERNAME=your_username
DIGIFLAZZ_API_KEY=your_api_key
DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1

#################################
# PRODUCTION DOMAINS
#################################
NEXT_PUBLIC_API_URL=https://api.zelvira.my.id/api
NEXT_PUBLIC_STORAGE_URL=https://minio.zelvira.my.id
NEXT_PUBLIC_ADMIN_URL=https://admin.zelvira.my.id
NEXT_PUBLIC_WEB_URL=https://zelvira.my.id

#################################
# TIKTOK SHOP & SOCIAL API
#################################
TIKTOK_APP_KEY=your_tiktok_app_key
TIKTOK_APP_SECRET=your_tiktok_app_secret
TIKTOK_AUTH_URL=https://auth.tiktok-shops.com/oauth/authorize
TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_SOCIAL_CLIENT_KEY=your_social_client_key
TIKTOK_SOCIAL_CLIENT_SECRET=your_social_client_secret
TIKTOK_SOCIAL_REDIRECT_URI=https://api.zelvira.my.id/api/v1/social/callback/tiktok

#################################
# META / INSTAGRAM / THREADS API
#################################
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_CONFIG_ID=your_instagram_config_id
INSTAGRAM_BUSINESS_ID=your_instagram_business_id
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
INSTAGRAM_ACCOUNT_USERNAME=zelviraofficialstore
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_verify_token
INSTAGRAM_REDIRECT_URI=https://api.zelvira.my.id/api/v1/callbacks/instagram/oauth
INSTAGRAM_SOCIAL_REDIRECT_URI=https://api.zelvira.my.id/api/v1/social/callback/instagram
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
FACEBOOK_REDIRECT_URI=https://api.zelvira.my.id/api/v1/social/callback/facebook
THREADS_APP_ID=your_threads_app_id
THREADS_APP_SECRET=your_threads_app_secret
THREADS_REDIRECT_URI=https://api.zelvira.my.id/api/v1/social/callback/threads

#################################
# LINKEDIN, X, YOUTUBE API
#################################
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_REDIRECT_URI=https://api.zelvira.my.id/api/v1/social/callback/linkedin
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_REDIRECT_URI=https://api.zelvira.my.id/api/v1/social/callback/x
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=https://api.zelvira.my.id/api/v1/social/callback/youtube

#################################
# NVIDIA AI API
#################################
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
